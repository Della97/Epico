#!/usr/bin/env python3
"""epico-viz — pick a pipeline, pick a run, get a page.

    ./epico-viz                     # interactive: choose pipeline, then run
    ./epico-viz -p dag-nested       # skip the first prompt
    ./epico-viz -p dag-nested -r 0  # newest run of it, no prompts at all
    ./epico-viz --list              # just show what is available

Reads a run's summary + logs, writes a self-contained HTML page, serves it on
localhost and opens a browser. Standard library only — no install step.
"""

from __future__ import annotations

import argparse
import http.server
import os
import socketserver
import sys
import threading
import webbrowser

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from epico_viz.discover import (Pipeline, Run, find_repo_root, list_pipelines,  # noqa: E402
                                list_runs)
from epico_viz.model import build_model                                        # noqa: E402
from epico_viz.page import logo_data_uri, render                             # noqa: E402


# ── terminal helpers ─────────────────────────────────────────────────────────

def _tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


C = {"dim": "\033[2m", "b": "\033[1m", "acc": "\033[36m", "warn": "\033[33m",
     "bad": "\033[31m", "off": "\033[0m"}
if not sys.stdout.isatty():
    C = {k: "" for k in C}


def choose(prompt: str, rows: list[str], default: int = 0) -> int:
    """Numbered picker. Enter takes the default."""
    for i, row in enumerate(rows):
        mark = f"{C['acc']}›{C['off']}" if i == default else " "
        print(f" {mark} {C['b']}{i:>2}{C['off']}  {row}")
    while True:
        raw = input(f"\n{prompt} [{default}]: ").strip()
        if not raw:
            return default
        if raw.lower() in ("q", "quit", "exit"):
            raise SystemExit(0)
        if raw.isdigit() and 0 <= int(raw) < len(rows):
            return int(raw)
        print(f"{C['warn']}enter a number 0–{len(rows)-1}, or q to quit{C['off']}")


def fmt_run(r: Run, i: int) -> str:
    when = r.run_id
    if r.broken:
        return f"{when:<22} {C['bad']}unreadable summary{C['off']}"
    return (f"{when:<22} {r.events:>10,} events  {r.duration_s:>7.2f}s  "
            f"p50 {r.p50_ms:>8.2f}ms  p99 {r.p99_ms:>8.2f}ms  "
            f"{r.stages:>2} stages  {C['dim']}{r.layout}{C['off']}")


# ── serving ──────────────────────────────────────────────────────────────────

def serve(directory: str, port: int, open_browser: bool) -> None:
    class Handler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=directory, **kw)

        def log_message(self, *a):        # keep the terminal clean
            pass

    class Server(socketserver.TCPServer):
        allow_reuse_address = True

    try:
        httpd = Server(("127.0.0.1", port), Handler)
    except OSError as e:
        raise SystemExit(f"cannot bind 127.0.0.1:{port} — {e}\n"
                         f"pick another with --port")
    url = f"http://127.0.0.1:{httpd.server_address[1]}/index.html"
    # flush: stdout is block-buffered when redirected, which would hide the URL
    # until the server is stopped.
    print(f"\n{C['b']}serving{C['off']} {url}")
    print(f"{C['dim']}(the page is standalone — {os.path.join(directory, 'index.html')} "
          f"also opens straight from disk){C['off']}")
    print(f"{C['dim']}Ctrl+C to stop{C['off']}", flush=True)
    if open_browser:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


# ── main ─────────────────────────────────────────────────────────────────────

def main() -> None:
    ap = argparse.ArgumentParser(
        prog="epico-viz", description="Visualise one Epico pipeline run.")
    ap.add_argument("-p", "--pipeline", help="pipeline name under examples/ (skips the prompt)")
    ap.add_argument("-r", "--run", help="run id, or an index (0 = newest)")
    ap.add_argument("--port", type=int, default=8777, help="port to serve on (default 8777)")
    ap.add_argument("--out", help="where to write the page (default epico-viz/out/)")
    ap.add_argument("--no-open", action="store_true", help="do not open a browser")
    ap.add_argument("--no-serve", action="store_true", help="write the page and exit")
    ap.add_argument("--list", action="store_true", help="list pipelines and runs, then exit")
    args = ap.parse_args()

    here = os.path.dirname(os.path.abspath(__file__))
    root = find_repo_root(here)
    pipelines = list_pipelines(root)
    if not pipelines:
        raise SystemExit(f"no pipelines found under {root}/examples")

    if args.list:
        for p in pipelines:
            print(f"\n{C['b']}{p.name}{C['off']}  "
                  f"{C['dim']}{p.stage_count} stages, {p.edge_count} edges{C['off']}")
            runs = list_runs(p)
            if not runs:
                print("   (no runs)")
            for i, r in enumerate(runs):
                print(f"   {i:>2}  {fmt_run(r, i)}")
        return

    # ── pick the pipeline ───────────────────────────────────────────────────
    if args.pipeline:
        match = [p for p in pipelines if p.name == args.pipeline]
        if not match:
            raise SystemExit(f"no pipeline named {args.pipeline!r}. "
                             f"Have: {', '.join(p.name for p in pipelines)}")
        pipeline = match[0]
    else:
        if not _tty():
            raise SystemExit("not a terminal — pass --pipeline/--run explicitly")
        print(f"\n{C['b']}Pipelines{C['off']} {C['dim']}in {root}/examples{C['off']}\n")
        runnable = [p for p in pipelines if p.run_count]
        rows = [f"{p.name:<20} {p.stage_count:>2} stages  {p.edge_count:>2} edges  "
                f"{p.run_count:>3} run(s)"
                + ("" if p.run_count else f"  {C['dim']}— nothing recorded yet{C['off']}")
                for p in pipelines]
        default = pipelines.index(runnable[0]) if runnable else 0
        pipeline = pipelines[choose("pipeline", rows, default)]

    runs = list_runs(pipeline)
    if not runs:
        raise SystemExit(f"{pipeline.name} has no recorded runs under {pipeline.logs_dir}\n"
                         f"run it first:  cd {pipeline.path} && epico run")

    # ── pick the run ────────────────────────────────────────────────────────
    if args.run is not None:
        if args.run.isdigit() and int(args.run) < len(runs):
            run = runs[int(args.run)]
        else:
            match = [r for r in runs if r.run_id == args.run]
            if not match:
                raise SystemExit(f"no run {args.run!r} for {pipeline.name}. "
                                 f"Use --list to see them.")
            run = match[0]
    else:
        if not _tty():
            raise SystemExit("not a terminal — pass --run explicitly")
        print(f"\n{C['b']}Runs of {pipeline.name}{C['off']} {C['dim']}newest first{C['off']}\n")
        run = runs[choose("run", [fmt_run(r, i) for i, r in enumerate(runs)], 0)]

    if run.broken:
        raise SystemExit(f"that run's summary cannot be read: {run.broken}")

    # ── build ───────────────────────────────────────────────────────────────
    print(f"\nreading {C['dim']}{run.summary_path}{C['off']}")
    model = build_model(pipeline, run)
    html = render(model, logo=logo_data_uri(root))

    out_root = args.out or os.path.join(here, "out")
    out_dir = os.path.join(out_root, f"{pipeline.name}__{run.run_id}")
    os.makedirs(out_dir, exist_ok=True)
    out_file = os.path.join(out_dir, "index.html")
    with open(out_file, "w") as fh:
        fh.write(html)
    print(f"wrote   {out_file} ({os.path.getsize(out_file)/1024:.0f} KB)")

    for w in model["warnings"]:
        print(f"{C['warn']}note{C['off']}    {w}")

    if args.no_serve:
        return
    serve(out_dir, args.port, not args.no_open)


if __name__ == "__main__":
    main()
